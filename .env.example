# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional application overrides (defaults shown)
AIRCRAFT_DESIGN_MODEL=gpt-5.6-sol
AIRCRAFT_DESIGN_TEMPERATURE=0
AIRCRAFT_DESIGN_HOST=localhost
AIRCRAFT_DESIGN_PORT=7860
AIRCRAFT_DESIGN_GPU_COUNT=4
AIRCRAFT_DESIGN_GPU_POLL_INTERVAL=0.25
# Optional: private plugin directory when runtime outputs use another root
# AIRCRAFT_DESIGN_PRIVATE_PLUGINS_DIR=plugins/private
